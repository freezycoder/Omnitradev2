# Optional: live Finnhub news/market headlines.
# Prefer ~/.config/omnitrade/secrets.env for real local secrets.
FINNHUB_API_KEY=replace_with_your_finnhub_key

# Optional: free FRED API key for the macro-regime shadow signal.
FRED_API_KEY=replace_with_your_fred_key

# Required by the SEC fair-access policy for EDGAR automation.
# Replace the contact with an address or site that can reach the operator.
SEC_EDGAR_USER_AGENT="OmniTrade/1.0 your-email@example.com"

# Hosted deployments should remain read-only. Local launchers set this to
# "local" explicitly when personal watchlist/performance writes are wanted.
OMNITRADE_WRITE_MODE=read_only

# Set this to the exact deployed frontend origin. Do not include a path.
OMNITRADE_CORS_ORIGINS=https://your-frontend.example.com

# Optional shared secret required on POST/DELETE when write mode is local
# (recommended for LAN). Send as header X-OmniTrade-Write-Token.
# OMNITRADE_WRITE_TOKEN=replace_with_a_long_random_string

# Optional request limits per client IP, per minute.
# OMNITRADE_MUTATION_RATE_LIMIT=20
# OMNITRADE_REFRESH_RATE_LIMIT=6
